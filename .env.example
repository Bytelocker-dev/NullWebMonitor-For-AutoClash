# NullWebMonitor configuration
#
# You do NOT need to fill this in by hand. Start the monitor and open the panel
# in a browser — the setup wizard writes this file for you.
#
# This file is only here as a reference, and for anyone who prefers editing
# config directly. Copy it to `.env` if you want to start from it.
#
# Never commit your real .env — it holds your bot token and password hash.

# ---------------------------------------------------------------------------
# Web panel
# ---------------------------------------------------------------------------

# Set a password here in plaintext and it is converted to WEB_PASSWORD_HASH on
# the next start, then removed from this file. Or just use the setup wizard.
WEB_PASSWORD=

# Written automatically. Never put a plaintext password here.
# WEB_PASSWORD_HASH=

WEB_ENABLED=true
WEB_PORT=8477

# 0.0.0.0 = reachable on your LAN and over Tailscale.
# Set your Tailscale IP (100.x.y.z) to accept Tailscale connections only.
WEB_HOST=0.0.0.0

# ---------------------------------------------------------------------------
# AutoClash instances
# ---------------------------------------------------------------------------
#
# Format, one entry per window, separated by ";" :
#   id|label|autoClashFolder|adbDevice|version|autoStart
#
# Point the folder at the AutoClash install directory (not the .exe) so updates
# to a new AutoClash-x.y.z.exe are picked up automatically.
#
# Example with two instances:
# AUTOCONTROL_INSTANCES=Main|Main|C:\AutoClash\Main|127.0.0.1:16384|pro|true;Alt|Alt|C:\AutoClash\Alt|127.0.0.1:16416|pro|true
AUTOCONTROL_INSTANCES=

# Log folders, one per instance: name=path, separated by ";"
# The name must match the instance label above.
# LOG_FILES=Main=C:\AutoClash\Main\logs;Alt=C:\AutoClash\Alt\logs
LOG_FILES=

AUTOCONTROL_ENABLED=true

# Path to adb.exe. AutoClash ships one at <folder>\Tools\adb\adb.exe.
# Without this, screenshots, live view, tap control and the frozen-screen
# check are skipped (the rest still works).
AUTOCONTROL_ADB_PATH=

# mumu | ldplayer — leave blank to auto-detect.
EMULATOR=

# Only needed if MuMu is installed somewhere unusual.
# MUMU_MANAGER_PATH=C:\Program Files\Netease\MuMuPlayer\nx_main\MuMuManager.exe
# LDPLAYER_CONSOLE_PATH=C:\LDPlayer\LDPlayer9\ldconsole.exe

# ---------------------------------------------------------------------------
# Monitoring
# ---------------------------------------------------------------------------

CHECK_INTERVAL_SECONDS=5
STALLED_AFTER_SECONDS=180
MAX_LINES_PER_CHECK=10
MAX_STORED_LINES=20

# How many instances are checked at once. Raise it if you run many windows.
CHECK_CONCURRENCY=3
# Spacing between each instance's heavy checks, so they do not all fire together.
CHECK_STAGGER_MS=7000

COC_VISUAL_CHECK_ENABLED=true
COC_VISUAL_CHECK_INTERVAL_SECONDS=30
ADB_RECOVERY_STOP_DELAY_SECONDS=8
ADB_RECOVERY_START_DELAY_SECONDS=5
AUTO_RESTART_MODE=off

# Frozen-screen detection: compares a perceptual hash of the emulator screen.
STUCK_CHECK_ENABLED=true
STUCK_CHECK_INTERVAL_SECONDS=180
STUCK_CHECK_STRIKES=3
STUCK_HASH_TOLERANCE=4

# Classifies crashes, device errors, restarts and recoveries out of the logs.
LOG_FAULT_INCIDENTS=true
LOG_FAULT_COOLDOWN_SECONDS=900

# ---------------------------------------------------------------------------
# Launching
# ---------------------------------------------------------------------------

APP_AUTOSTART_BOT=false
# Pause after the Activate click before Stop/Start. A cold start needs longer.
APP_LAUNCH_SETTLE_SECONDS=20
APP_AUTOSTART_LOG_WAIT_SECONDS=150
APP_AUTOSTART_MAX_ATTEMPTS=3

# ---------------------------------------------------------------------------
# Live view and screenshots
# ---------------------------------------------------------------------------

LIVE_VIEW_WIDTH=720
LIVE_VIEW_QUALITY=70
SCREENSHOT_RETENTION_HOURS=24
SCREENSHOT_MAX_SIZE_MB=300
INCIDENT_KEEP=400
INCIDENT_IMAGE_WIDTH=1280
INCIDENT_IMAGE_QUALITY=80

# ---------------------------------------------------------------------------
# Discord (optional — the panel works fully without it)
# ---------------------------------------------------------------------------
#
# See the Setup & User Guide tab in the panel for a step-by-step walkthrough.
# Treat the token like a password.

DISCORD_ENABLED=false
DISCORD_TOKEN=
# The control panel channel: buttons, overall status and the daily summary.
DISCORD_CHANNEL_ID=
AUTOCONTROL_CHANNEL_ID=
AUTOCONTROL_SEND_PANEL_ON_START=true
AUTOCONTROL_AUTO_UPDATE_ENABLED=false

# Remove the bot's own old messages on start so restarts do not stack panels.
# Only messages this bot posted are deleted.
DISCORD_CLEAN_ON_START=true

# Each instance can post to its own channel instead of the panel channel.
# The env key comes from the instance name: "My Main" -> MY_MAIN_*
#   <NAME>_CHANNEL_ID    where that instance posts. Blank = the panel channel.
#   <NAME>_CHANNEL_NAME  what the bot renames that channel to as status
#                        changes, e.g. main-farm -> 🟢-main-farm / 🟠 / 🔴.
#                        Needs the Manage Channels permission.
# MY_MAIN_CHANNEL_ID=
# MY_MAIN_CHANNEL_NAME=my-main

LIVE_LOG_ENABLED=false
LIVE_LOG_INTERVAL_SECONDS=10
LIVE_LOG_MAX_THREAD_MESSAGES=10000

DAILY_SUMMARY_ENABLED=true
DAILY_SUMMARY_HOUR=9

# ---------------------------------------------------------------------------
# Phone alerts via ntfy (optional)
# ---------------------------------------------------------------------------
#
# WARNING: the topic name is the ONLY thing protecting your alerts on the public
# ntfy.sh server. Use a long random string and keep it private, or self-host.

NTFY_ENABLED=false
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh
NTFY_MIN_SEVERITY=warn
