{
  "name": "xor-webmonitor",
  "version": "2.0.5",
  "description": "Self-hosted web control panel for AutoClash — live view, stats, logs, incidents and remote config, reachable from your phone over Tailscale or Cloudflare.",
  "main": "bot.js",
  "scripts": {
    "start": "node bot.js",
    "watch": "node watchdog.js",
    "test": "node test/run-all.js",
    "doctor": "node scripts/doctor.js",
    "clean": "node scripts/clean.js",
    "reset-password": "node bot.js --reset-password",
    "check-secrets": "node scripts/check-secrets.js",
    "icons": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/powershell/make-icons.ps1",
    "css": "tailwindcss -i ./src/input.css -o ./public/css/tw.css --minify",
    "css:watch": "tailwindcss -i ./src/input.css -o ./public/css/tw.css --watch",
    "build": "npm run css"
  },
  "keywords": [
    "autoclash",
    "clash-of-clans",
    "monitor",
    "self-hosted",
    "tailscale",
    "pwa"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "os": [
    "win32"
  ],
  "dependencies": {
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "tailwindcss": "^4.3.3"
  }
}
